{
  "name": "htpn-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node -e \"if(!process.env.VERCEL){require('child_process').execSync('react-snap',{stdio:'inherit'})}\"",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "include": [
      "/",
      "/projects/preconsult-gynae",
      "/projects/preconsult-obstetric",
      "/projects/fetal-kick-chart",
      "/projects/skin-diary",
      "/projects/ot-scheduling",
      "/projects/gynae-census",
      "/projects/ebl-estimator",
      "/projects/therapy-ai",
      "/projects/ed-dashboard",
      "/projects/dlp-dashboard",
      "/projects/roster-generator",
      "/projects/cgr-form",
      "/projects/dlp-form",
      "/projects/portal-aktiviti",
      "/projects/incident-form",
      "/projects/pdf-editor",
      "/projects/e-kehadiran",
      "/pipeline/amr",
      "/pipeline/drone-specimen",
      "/pipeline/prison-virtual-clinic",
      "/pipeline/facial-scan-ai"
    ],
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "skipThirdPartyRequests": true,
    "inlineCss": false
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "framer-motion": "^12.36.0",
    "gsap": "^3.14.2",
    "meshline": "^3.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.1",
    "react-snap": "^1.23.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.4"
  }
}
